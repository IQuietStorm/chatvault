# ChatVault server configuration — copy to .env and fill secrets
NODE_ENV=development
PORT=3000

# Postgres / Redis
DATABASE_URL=postgres://chatvault:chatvault@localhost:5432/chatvault
REDIS_URL=redis://localhost:6379

# JWT — use long random secrets (openssl rand -hex 32)
ACCESS_SECRET=change-me-access-secret-32-chars-min
REFRESH_SECRET=change-me-refresh-secret-32-chars-min
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY= # -----BEGIN PRIVATE KEY----- ... (P8, single line)

# SMS OTP (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# AWS S3 + CloudFront
S3_BUCKET=chatvault-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=
VIEW_ONCE_TTL_SECONDS=30

# TURN (Coturn REST API credentials)
TURN_SECRET=change-me-turn-secret
TURN_URLS=turn:turn.chatvault.app:3478?transport=udp,turn:turn.chatvault.app:3478?transport=tcp

# Age gate
MIN_AGE=18
